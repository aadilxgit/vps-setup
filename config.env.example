# =============================================================================
# VPS Setup — Configuration File Example
# =============================================================================
# Copy this file to config.env and edit it with your target settings:
#   cp config.env.example config.env
# =============================================================================

# === User Configuration ===
# Non-root user to create (password login disabled, SSH key only)
USERNAME="username"

# Space-separated list of accounts allowed to log in via OpenSSH (default: same as USERNAME)
ALLOW_USERS="username"

# Port for the main OpenSSH server (post-install)
# Dropbear (LUKS unlock) always uses port 22 in initramfs.
SSH_PORT="2222"

# Your SSH public key (paste the full line from ~/.ssh/id_ed25519.pub or similar).
# This key is used for:
#   1. Main SSH login (password auth is completely disabled)
#   2. Dropbear initramfs login (for remote LUKS unlock at boot)
SSH_PUBKEY="ssh-ed25519 AAAA... user@host"

# === System Configuration ===
HOSTNAME="vps"
DOMAIN=""
TIMEZONE="Asia/Kolkata"
LOCALE="en_US.UTF-8"
KEYMAP="us"

# Path to save the post-install LUKS header backup file
LUKS_HEADER_BACKUP_PATH="/root/luks-header-backup.img"

# === Debian Configuration ===
# Target Debian release (trixie = Debian 13 stable)
DEBIAN_RELEASE="trixie"
DEBIAN_MIRROR="https://deb.debian.org/debian"

# Allow SSH TCP forwarding (e.g. ssh -L local:remote). Set to "true" or "false" (default: false)
ALLOW_SSH_FORWARDING="false"

# === Installation Role ===
# Supported roles:
#   "standard"    - Normal VPS mode (default). Detects ONLY the current OS/root disk
#                   and installs Debian on it. All secondary disks are completely
#                   ignored and left untouched.
#   "storage-vps" - Storage VPS mode. Detects OS disk + scans additional disks.
#                   Prompts interactively for each extra disk (leave untouched,
#                   format & mount, manual). No disk is modified without explicit confirmation.
INSTALL_ROLE="standard"
STORAGE_AUTO_MOUNT="false"

# Disk wipe mode during preseed: "fast" (skip random data wipe) or "secure" (overwrite free sectors)
WIPE_MODE="fast"

# === Disk Configuration ===
# Leave empty to auto-detect the primary OS disk (where '/' is mounted).
# Only set DISK="/dev/..." if you want to manually override the OS target disk.
DISK=""

# === Network Configuration ===
# Leave ALL empty to auto-detect from the running system.
# Set any field to override the detected value.
# The script will display detected values and let you confirm before proceeding.
IPV4_ADDRESS=""       # e.g., 203.0.113.10
IPV4_NETMASK=""       # e.g., 255.255.255.0
IPV4_GATEWAY=""       # e.g., 203.0.113.1
IPV6_ADDRESS=""       # e.g., 2001:db8::10
IPV6_PREFIX=""        # e.g., 64
IPV6_GATEWAY=""       # e.g., 2001:db8::1
DNS_SERVERS="1.1.1.1 1.0.0.1"
INTERFACE=""          # e.g., eth0, ens3

# === Additional Packages ===
# Space-separated list of extra packages to install
EXTRA_PACKAGES="git vim htop tmux curl wget rsync net-tools dnsutils mtr-tiny iotop bash-completion lsof strace fastfetch"
