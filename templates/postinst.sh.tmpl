#!/usr/bin/env bash
# =============================================================================
# Post-Install Configuration Script
# =============================================================================
# This script runs inside the newly installed Debian system via preseed
# late_command. It configures:
#   1. LUKS key swap (register real passphrase, remove temporary installer key)
#   2. SSH hardening (custom port, key-only auth, disabled root)
#   3. Dropbear initramfs (remote LUKS unlock)
#   4. Static network configuration (IPv4 + IPv6 dual-stack)
#   5. UFW firewall
#   6. Fail2ban intrusion prevention
#   7. Unattended security upgrades
#   8. System hardening (sysctl, PAM, secure /tmp and /dev/shm)
#   9. Secondary storage disks (storage-vps role only)
#  10. Log sanitization and cleanup
#
# Generated by vps-setup/setup.sh — do not edit directly.
# =============================================================================

set -euo pipefail
exec > /var/log/vps-postinst.log 2>&1
echo "=== VPS Post-Install Script Started: $(date) ==="

# ─────────────────────────────────────────────────────────────────────────────
# 1. LUKS Passphrase Swap (Register Real Passphrase & Remove Temp Key)
# ─────────────────────────────────────────────────────────────────────────────
echo ">>> Swapping LUKS temporary key with user's real passphrase..."

luks_target=""
for dev in $(lsblk -pnl -o PATH,FSTYPE "__DISK__" 2>/dev/null | awk '$2 == "crypto_LUKS" {print $1}'); do
    luks_target="${dev}"
    break
done

if [[ -z "${luks_target}" ]]; then
    # Fallback: scan partitions on __DISK__
    for p in "__DISK__"1 "__DISK__"2 "__DISK__"3 "__DISK__"p1 "__DISK__"p2 "__DISK__"p3; do
        if cryptsetup isLuks "${p}" 2>/dev/null; then
            luks_target="${p}"
            break
        fi
    done
fi

if [[ -z "${luks_target}" || ! -b "${luks_target}" ]]; then
    echo "    ✗ FATAL: LUKS volume device target not identified on __DISK__!" >&2
    echo "      Cannot perform LUKS key rotation. System setup aborted." >&2
    touch /var/log/vps-postinst.LUKS-SWAP-FAILED
    exit 1
fi

# Ensure stale key files are removed before decryption
rm -f /tmp/.real.key /tmp/.secret_keys.enc 2>/dev/null || true

# Write temporary key to RAM file
printf "%s" "__TEMP_LUKS_KEY__" > /tmp/.temp.key
chmod 600 /tmp/.temp.key

# Fetch encrypted secret payload over HTTP directly into restricted installer RAM using unguessable token
if wget -q -O /tmp/.secret_keys.enc "http://__PRESEED_SERVER__/__INSTALL_TOKEN__/.secret_keys.enc" 2>/dev/null && [[ -f /tmp/.secret_keys.enc ]]; then
    chmod 600 /tmp/.secret_keys.enc
    # Decrypt AES-256-CBC payload directly into key file without shell code execution
    TEMP_LUKS_KEY="__TEMP_LUKS_KEY__" openssl enc -d -aes-256-cbc -pbkdf2 -pass env:TEMP_LUKS_KEY -in /tmp/.secret_keys.enc -out /tmp/.real.key 2>/dev/null || true
    chmod 600 /tmp/.real.key 2>/dev/null || true
    rm -f /tmp/.secret_keys.enc
fi

# Verify non-empty key file (-s test)
if [[ ! -s /tmp/.real.key ]]; then
    echo "    ✗ FATAL: Failed to decrypt real LUKS key payload (file missing or empty)!" >&2
    touch /var/log/vps-postinst.LUKS-SWAP-FAILED
    shred -u /tmp/.temp.key /tmp/.real.key 2>/dev/null || rm -f /tmp/.temp.key /tmp/.real.key
    exit 1
fi

# 1. Add real user passphrase
if cryptsetup luksAddKey "${luks_target}" /tmp/.real.key --key-file /tmp/.temp.key 2>/dev/null; then
    # 2. Verify real key works
    if ! cryptsetup luksOpen --test-passphrase "${luks_target}" --key-file /tmp/.real.key 2>/dev/null; then
        echo "    ✗ FATAL: Real LUKS passphrase verification failed!" >&2
        touch /var/log/vps-postinst.LUKS-SWAP-FAILED
        shred -u /tmp/.temp.key /tmp/.real.key 2>/dev/null || rm -f /tmp/.temp.key /tmp/.real.key
        exit 1
    fi

    # 3. Remove temporary installer key
    if cryptsetup luksRemoveKey "${luks_target}" --key-file /tmp/.temp.key 2>/dev/null; then
        # 4. Verify temporary key no longer unlocks volume
        if cryptsetup luksOpen --test-passphrase "${luks_target}" --key-file /tmp/.temp.key 2>/dev/null; then
            echo "    ✗ FATAL: Temporary installer key is still active! Removal failed." >&2
            touch /var/log/vps-postinst.LUKS-SWAP-FAILED
            shred -u /tmp/.temp.key /tmp/.real.key 2>/dev/null || rm -f /tmp/.temp.key /tmp/.real.key
            exit 1
        fi
        echo "    ✓ Real LUKS passphrase registered and verified; temporary installer key removed."
    else
        echo "    ✗ FATAL: Could not remove temporary installer key from ${luks_target}." >&2
        touch /var/log/vps-postinst.LUKS-SWAP-FAILED
        shred -u /tmp/.temp.key /tmp/.real.key 2>/dev/null || rm -f /tmp/.temp.key /tmp/.real.key
        exit 1
    fi
else
    echo "    ✗ FATAL: Could not add real LUKS key to ${luks_target}." >&2
    echo "      The disk still uses the temporary installer key only." >&2
    touch /var/log/vps-postinst.LUKS-SWAP-FAILED
    shred -u /tmp/.temp.key /tmp/.real.key 2>/dev/null || rm -f /tmp/.temp.key /tmp/.real.key
    exit 1
fi

# 5. Backup LUKS header for disaster recovery
local header_backup_file="__LUKS_HEADER_BACKUP_PATH__"
echo ">>> Creating LUKS header backup at ${header_backup_file}..."
mkdir -p "$(dirname "${header_backup_file}")" 2>/dev/null || true
cryptsetup luksHeaderBackup "${luks_target}" --header-backup-file "${header_backup_file}" 2>/dev/null || true
if [[ -f "${header_backup_file}" ]]; then
    chmod 600 "${header_backup_file}"
    echo "    ✓ LUKS header backup created at ${header_backup_file}."
    echo "      WARNING: Move this file off the VPS and encrypt it before storing."
    echo "               Do not leave the only copy on this machine."
fi

shred -u /tmp/.temp.key /tmp/.real.key 2>/dev/null || rm -f /tmp/.temp.key /tmp/.real.key

# ─────────────────────────────────────────────────────────────────────────────
# 2. SSH Hardening
# ─────────────────────────────────────────────────────────────────────────────
echo ">>> Configuring SSH..."

# Create .ssh directory and add authorized key
mkdir -p /home/__USERNAME__/.ssh
chmod 700 /home/__USERNAME__/.ssh
echo "__SSH_PUBKEY__" > /home/__USERNAME__/.ssh/authorized_keys
chmod 600 /home/__USERNAME__/.ssh/authorized_keys
chown -R __USERNAME__:__USERNAME__ /home/__USERNAME__/.ssh

# Harden sshd_config
cat > /etc/ssh/sshd_config.d/hardened.conf << 'SSHEOF'
# === VPS Setup — SSH Hardening ===
Port __SSH_PORT__

# Authentication
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM yes

# Security & Restriction
X11Forwarding no
AllowTcpForwarding __ALLOW_SSH_FORWARDING__
AllowAgentForwarding no
PermitTunnel no
MaxAuthTries 3
MaxSessions 5
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2

# Disable unused auth methods
HostbasedAuthentication no
IgnoreRhosts yes

# Logging
LogLevel VERBOSE
SyslogFacility AUTH

# Only allow explicit user accounts
AllowUsers __ALLOW_USERS__
SSHEOF

echo "    ✓ SSH hardened (port __SSH_PORT__, key-only, root disabled, tcp-forwarding: __ALLOW_SSH_FORWARDING__)"

# ─────────────────────────────────────────────────────────────────────────────
# 3. Dropbear Initramfs (Remote LUKS Unlock)
# ─────────────────────────────────────────────────────────────────────────────
echo ">>> Configuring Dropbear initramfs for remote LUKS unlock..."

apt-get install -y -qq dropbear-initramfs cryptsetup-initramfs 2>/dev/null || true

# Disable dropbear from running as a background service in the booted OS
systemctl disable dropbear 2>/dev/null || true
systemctl stop dropbear 2>/dev/null || true

# Configure dropbear — runs strictly inside initramfs on port 22
mkdir -p /etc/dropbear/initramfs
cat > /etc/dropbear/initramfs/dropbear.conf << 'DROPEOF'
DROPBEAR_OPTIONS="-I 180 -j -k -p 22 -s -c /bin/cryptroot-unlock"
DROPEOF

# Add SSH public key for initramfs login
echo "__SSH_PUBKEY__" > /etc/dropbear/initramfs/authorized_keys
chmod 600 /etc/dropbear/initramfs/authorized_keys

# Configure initramfs networking (device-agnostic auto-binding)
cat > /etc/initramfs-tools/conf.d/ip << 'IPEOF'
IP=__INITRAMFS_IP__
IPEOF

# Ensure cryptsetup is included in initramfs
cat > /etc/initramfs-tools/conf.d/cryptsetup << 'CRYPTEOF'
CRYPTSETUP=y
CRYPTEOF

echo "    ✓ Dropbear configured (port 22, key-only, auto-unlock prompt)"

# ─────────────────────────────────────────────────────────────────────────────
# 4. Network Configuration (Static IPv4 + IPv6 Dual-Stack)
# ─────────────────────────────────────────────────────────────────────────────
echo ">>> Configuring network..."

cat > /etc/network/interfaces << 'NETEOF'
# Loopback
auto lo
iface lo inet loopback

# Primary network interface — IPv4
auto __INTERFACE__
iface __INTERFACE__ inet static
    address __IPV4_ADDRESS__/__IPV4_CIDR__
    gateway __IPV4_GATEWAY__
    dns-nameservers __DNS_SERVERS__
NETEOF

IPV6_ADDR="__IPV6_ADDRESS__"
if [[ -n "${IPV6_ADDR}" ]]; then
    cat >> /etc/network/interfaces << 'IPV6EOF'

# Primary network interface — IPv6
iface __INTERFACE__ inet6 static
    address __IPV6_ADDRESS__/__IPV6_PREFIX__
    gateway __IPV6_GATEWAY__
IPV6EOF
    echo "    ✓ Network configured (dual-stack IPv4 + IPv6)"
else
    echo "    ✓ Network configured (IPv4 only)"
fi

# Configure DNS
cat > /etc/resolv.conf << 'DNSEOF'
# Generated by vps-setup
DNSEOF

for ns in __DNS_SERVERS__; do
    echo "nameserver ${ns}" >> /etc/resolv.conf
done

# Set hostname
echo "__HOSTNAME__" > /etc/hostname
cat > /etc/hosts << HOSTSEOF
127.0.0.1   localhost
127.0.1.1   __HOSTNAME__

# IPv6
::1         localhost ip6-localhost ip6-loopback
ff02::1     ip6-allnodes
ff02::2     ip6-allrouters
HOSTSEOF

# ─────────────────────────────────────────────────────────────────────────────
# 5. UFW Firewall
# ─────────────────────────────────────────────────────────────────────────────
apt-get install -y -qq ufw fail2ban 2>/dev/null || true

if command -v ufw >/dev/null 2>&1; then
    ufw --force reset >/dev/null 2>&1
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow __SSH_PORT__/tcp comment 'SSH'
    ufw --force enable
    echo "    ✓ UFW enabled (allow port __SSH_PORT__/tcp)"
else
    echo "    ⚠ ufw not installed (skipping firewall configuration)"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 6. Fail2ban & Security Services
# ─────────────────────────────────────────────────────────────────────────────
echo ">>> Configuring Fail2ban & Auditd..."

if [[ -d /etc/fail2ban ]]; then
    cat > /etc/fail2ban/jail.local << F2BEOF
[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 3
backend = systemd
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
port = __SSH_PORT__
filter = sshd
logpath = %(sshd_log)s
maxretry = 3
bantime = 3600
F2BEOF
fi

systemctl enable fail2ban 2>/dev/null || true
systemctl enable auditd 2>/dev/null || true

echo "    ✓ Fail2ban & auditd configured"

# ─────────────────────────────────────────────────────────────────────────────
# 7. Unattended Upgrades
# ─────────────────────────────────────────────────────────────────────────────
echo ">>> Configuring unattended upgrades..."

cat > /etc/apt/apt.conf.d/20auto-upgrades << 'APTEOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::Download-Upgradeable-Packages "1";
APT::Periodic::AutocleanInterval "7";
APTEOF

cat > /etc/apt/apt.conf.d/50unattended-upgrades << 'UUEOF'
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESM:${distro_codename}-infra-security";
};
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::SyslogEnable "true";
UUEOF

echo "    ✓ Unattended security upgrades enabled"

# ─────────────────────────────────────────────────────────────────────────────
# 8. System Hardening & Secure Filesystems
# ─────────────────────────────────────────────────────────────────────────────
echo ">>> Applying kernel hardening and securing /tmp and /dev/shm..."

cat > /etc/sysctl.d/99-vps-hardening.conf << 'SYSEOF'
# === VPS Setup — System Hardening ===

# --- Kernel Security ---
kernel.kptr_restrict = 2
kernel.dmesg_restrict = 1
kernel.sysrq = 176
kernel.yama.ptrace_scope = 1

# --- Network Security ---
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.ip_forward = 0
net.ipv6.conf.all.forwarding = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.conf.all.log_martians = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_max_syn_backlog = 2048
net.ipv4.tcp_synack_retries = 2

# --- IPv6 Privacy ---
net.ipv6.conf.all.use_tempaddr = 0
net.ipv6.conf.default.use_tempaddr = 0
net.ipv6.conf.all.accept_ra = 0
net.ipv6.conf.default.accept_ra = 0
SYSEOF

# Secure temporary filesystems (/tmp, /dev/shm, /run/shm)
if ! grep -q ' /tmp ' /etc/fstab 2>/dev/null; then
    echo "tmpfs /tmp tmpfs defaults,noexec,nosuid,nodev 0 0" >> /etc/fstab
fi
if ! grep -q ' /dev/shm ' /etc/fstab 2>/dev/null; then
    echo "tmpfs /dev/shm tmpfs defaults,noexec,nosuid,nodev 0 0" >> /etc/fstab
fi
if ! grep -q ' /run/shm ' /etc/fstab 2>/dev/null; then
    echo "tmpfs /run/shm tmpfs defaults,noexec,nosuid,nodev 0 0" >> /etc/fstab
fi

# Restrict su to sudo group
if [[ -f /etc/pam.d/su ]]; then
    if ! grep -q '^auth.*pam_wheel.so' /etc/pam.d/su; then
        echo "auth       required   pam_wheel.so group=sudo" >> /etc/pam.d/su
    fi
fi

# Ensure user is in sudo group
usermod -aG sudo __USERNAME__ 2>/dev/null || true

# Grant NOPASSWD sudo — account has no password (SSH key only)
echo "__USERNAME__ ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/00-__USERNAME__
chmod 440 /etc/sudoers.d/00-__USERNAME__
if ! visudo -c -f /etc/sudoers.d/00-__USERNAME__ >/dev/null 2>&1; then
    echo "    ✗ FATAL: Invalid sudoers drop-in created. Removing to keep sudo usable."
    rm -f /etc/sudoers.d/00-__USERNAME__
fi

echo "    ✓ Kernel hardening & secure mount flags applied"

# ─────────────────────────────────────────────────────────────────────────────
# 9. Fresh Editor Installation
# ─────────────────────────────────────────────────────────────────────────────
FRESH_VERSION="1.3.0"
FRESH_DEB="/tmp/fresh-editor_${FRESH_VERSION}-1_amd64.deb"
FRESH_URL="https://github.com/sinelaw/fresh/releases/download/v${FRESH_VERSION}/fresh-editor_${FRESH_VERSION}-1_amd64.deb"
FRESH_SHA256_URL="${FRESH_URL}.sha256"

if wget -qO "${FRESH_DEB}" "${FRESH_URL}" 2>/dev/null; then
    if wget -qO "${FRESH_DEB}.sha256" "${FRESH_SHA256_URL}" 2>/dev/null && \
       (cd /tmp && sha256sum -c "${FRESH_DEB}.sha256" &>/dev/null); then
        dpkg -i "${FRESH_DEB}" 2>/dev/null && apt-get install -f -y -qq 2>/dev/null && \
        echo "    ✓ Fresh editor v${FRESH_VERSION} verified and installed" || \
        echo "    ⚠ Fresh editor package install failed (skipping)"
    else
        # Install deb only if sha256 file matches
        echo "    ⚠ Fresh editor checksum verification failed (skipping untrusted artifact)"
    fi
    rm -f "${FRESH_DEB}" "${FRESH_DEB}.sha256" 2>/dev/null || true
else
    echo "    ⚠ Could not download Fresh editor artifact (skipping)"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 10. Secondary Disks Handling (Role: __INSTALL_ROLE__)
# ─────────────────────────────────────────────────────────────────────────────
ROLE="__INSTALL_ROLE__"
if [[ "${ROLE}" == "storage-vps" ]]; then
    echo ">>> Setting up user-approved secondary storage disks..."
    APPROVED_DISKS="__MOUNT_EXTRA_DISKS__"
    if [[ -n "${APPROVED_DISKS}" ]]; then
        idx=1
        for disk_dev in ${APPROVED_DISKS}; do
            if [[ -b "${disk_dev}" ]]; then
                mnt_point="/mnt/__HOSTNAME__-vol"
                if (( idx > 1 )); then
                    mnt_point="/mnt/__HOSTNAME__-vol${idx}"
                fi
                echo "    Setting up ${disk_dev} at ${mnt_point}..."
                mkdir -p "${mnt_point}"
                local fstype
                if [[ -z "$(blkid -s TYPE -o value "${disk_dev}" 2>/dev/null)" ]]; then
                    vol_label="__HOSTNAME__-vol"
                    vol_label="${vol_label:0:12}${idx}"
                    mkfs.ext4 -F -L "${vol_label}" "${disk_dev}"
                    fstype="ext4"
                else
                    fstype=$(blkid -s TYPE -o value "${disk_dev}" 2>/dev/null || echo "ext4")
                fi
                uuid=$(blkid -s UUID -o value "${disk_dev}" || true)
                if [[ -n "${uuid}" && -n "${fstype}" ]]; then
                    if ! grep -q "${uuid}" /etc/fstab; then
                        echo "UUID=${uuid} ${mnt_point} ${fstype} defaults,nofail 0 2" >> /etc/fstab
                    fi
                fi
                mount "${mnt_point}" 2>/dev/null || true
                idx=$((idx + 1))
            fi
        done
        echo "    ✓ Secondary disk(s) configured and mounted under /mnt/__HOSTNAME__-vol"
    else
        echo "    ✓ No secondary disks selected for auto-mount."
    fi
else
    echo ">>> INSTALL_ROLE='standard': All secondary disks left untouched."
fi

# ─────────────────────────────────────────────────────────────────────────────
# 11. Final Steps & Log Sanitization
# ─────────────────────────────────────────────────────────────────────────────
echo ">>> Running final steps and sanitizing logs..."

timedatectl set-timezone __TIMEZONE__ 2>/dev/null || \
    ln -sf /usr/share/zoneinfo/__TIMEZONE__ /etc/localtime

update-initramfs -u -k all

systemctl enable ssh 2>/dev/null || true
systemctl enable fail2ban 2>/dev/null || true
systemctl enable ufw 2>/dev/null || true

# Save immutable security baseline backup
echo ">>> Creating security configuration baseline backup in /root/security-baseline/..."
mkdir -p /root/security-baseline
cp /etc/ssh/sshd_config.d/hardened.conf /root/security-baseline/sshd_config 2>/dev/null || true
cp /etc/sysctl.d/99-vps-hardening.conf /root/security-baseline/sysctl.conf 2>/dev/null || true
cp /etc/fstab /root/security-baseline/fstab 2>/dev/null || true
if [[ -f /etc/sudoers.d/00-__USERNAME__ ]]; then
    cp /etc/sudoers.d/00-__USERNAME__ /root/security-baseline/00-__USERNAME__-sudoers 2>/dev/null || true
fi
chmod 700 /root/security-baseline
echo "    ✓ Security baseline saved to /root/security-baseline/"

# Generate installation summary report (/root/vps-install-summary.txt)
echo ">>> Generating installation summary report in /root/vps-install-summary.txt..."
{
    echo "============================================================================="
    echo "VPS Setup — Installation Summary"
    echo "============================================================================="
    echo "Installation Date: $(date -u +"%Y-%m-%d %H:%M:%S UTC")"
    echo "Hostname:          __HOSTNAME__"
    echo "OS:                Debian 13 (__DEBIAN_RELEASE__)"
    echo "Role:              __INSTALL_ROLE__"
    echo "OS Disk:           __DISK__"
    echo "Disk Size:         $(lsblk -dnbo SIZE "__DISK__" 2>/dev/null | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "unknown")"
    echo "Boot Mode:         $(if [[ -d /sys/firmware/efi ]]; then echo "UEFI"; else echo "BIOS/Legacy"; fi)"
    echo "LUKS Status:       LUKS2 enabled on ${luks_target:-__DISK__}"
    echo "LUKS Keyslots:     $(cryptsetup luksDump "${luks_target}" 2>/dev/null | grep -c "Keyslot" || echo "1 active")"
    echo "SSH Port:          __SSH_PORT__"
    echo "Unlock SSH Port:   22 (initramfs only)"
    echo "Firewall Status:   UFW active (port __SSH_PORT__/tcp allowed)"
    echo "Allowed Users:     __ALLOW_USERS__"
    echo "============================================================================="
} > /root/vps-install-summary.txt
chmod 600 /root/vps-install-summary.txt
echo "    ✓ Installation summary generated at /root/vps-install-summary.txt"

# Generate final LUKS verification report (/root/encryption-report.txt)
echo ">>> Generating final LUKS encryption report in /root/encryption-report.txt..."
{
    echo "============================================================================="
    echo "VPS Setup — Final LUKS Verification Report"
    echo "============================================================================="
    echo "Generated:         $(date -u +"%Y-%m-%d %H:%M:%S UTC")"
    echo "Target Device:     ${luks_target:-__DISK__}"
    echo "LUKS Version:      $(cryptsetup luksDump "${luks_target}" 2>/dev/null | grep "Version:" | awk '{print $2}' || echo "LUKS2")"
    echo "Cipher:            $(cryptsetup luksDump "${luks_target}" 2>/dev/null | grep "Cipher name:" | awk '{print $3}' || echo "aes")"
    echo ""
    echo "[1] Keyslot Verification:"
    echo "  - Real Passphrase: WORKS"
    echo "  - Temporary Key:   REMOVED (verification test confirmed failed)"
    echo "  - Active Keyslots:"
    cryptsetup luksDump "${luks_target}" 2>/dev/null | grep -E "Keyslot [0-9]" || echo "  Keyslot 0: luks2"
    echo ""
    echo "[2] Mapped Devices & Filesystem Encryption Status:"
    lsblk -f "${luks_target}" 2>/dev/null || lsblk -f
    echo "============================================================================="
} > /root/encryption-report.txt
chmod 600 /root/encryption-report.txt
echo "    ✓ Encryption report generated at /root/encryption-report.txt"

# Sanitize any key traces from log files
if [[ -f /var/log/vps-postinst.log ]]; then
    sed -i "s|__TEMP_LUKS_KEY__|[REDACTED]|g" /var/log/vps-postinst.log 2>/dev/null || true
    chmod 600 /var/log/vps-postinst.log 2>/dev/null || true
fi
if [[ -f /var/log/syslog ]]; then
    sed -i "s|__TEMP_LUKS_KEY__|[REDACTED]|g" /var/log/syslog 2>/dev/null || true
fi

echo ""
echo "=== VPS Post-Install Script Completed: $(date) ==="
echo "=== Log saved to /var/log/vps-postinst.log ==="
echo ""
echo "Summary:"
echo "  - Role: __INSTALL_ROLE__"
echo "  - SSH: port __SSH_PORT__, key-only auth, root disabled, tcp-forwarding: __ALLOW_SSH_FORWARDING__"
echo "  - Sudo: NOPASSWD for __USERNAME__"
echo "  - LUKS: user passphrase set; temporary installer key verified removed"
echo "  - Dropbear: remote unlock via SSH on port 22 in initramfs (disabled in main OS)"
echo "  - Firewall: UFW (port __SSH_PORT__/tcp allowed)"
echo "  - Reports: /root/encryption-report.txt, header backup __LUKS_HEADER_BACKUP_PATH__"
echo "  - Baseline: /root/security-baseline/"
echo "  - Security: fail2ban, auditd, sysctl hardening, secure /tmp and /dev/shm"
echo "  - Updates: automatic security upgrades enabled (security patches only)"
echo ""
echo "First Boot Verification Checklist:"
echo "  [ ] 1. Remote LUKS unlock: ssh root@YOUR_VPS_IP -p 22 (type passphrase)"
echo "  [ ] 2. Normal SSH login:   ssh __USERNAME__@YOUR_VPS_IP -p __SSH_PORT__"
echo "  [ ] 3. Check LUKS status:  cat /root/encryption-report.txt"
echo "  [ ] 4. Disaster recovery:  umask 077 && ssh -p __SSH_PORT__ __USERNAME__@YOUR_VPS_IP 'sudo cat __LUKS_HEADER_BACKUP_PATH__' > ./luks-header-backup.img"
echo "  [ ] 5. Baseline audit:     ls -la /root/security-baseline/"
