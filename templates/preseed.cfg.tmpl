### ==========================================================================
### Debian Preseed Configuration — Automated Installation with LUKS
### ==========================================================================
### Generated by vps-setup/setup.sh
### This file is served via a temporary HTTP server and consumed by the
### Debian installer during netboot installation.
### ==========================================================================

### --- Locale and Keyboard ---------------------------------------------------
d-i debian-installer/locale string __LOCALE__
d-i keyboard-configuration/xkb-keymap select __KEYMAP__
d-i console-setup/ask_detect boolean false

### --- Network Configuration -------------------------------------------------
# Network is pre-configured via kernel boot parameters (netcfg/get_*).
# These are fallback values in case the kernel params are not picked up.
d-i netcfg/choose_interface select __INTERFACE__
d-i netcfg/disable_autoconfig boolean true
d-i netcfg/get_ipaddress string __IPV4_ADDRESS__
d-i netcfg/get_netmask string __IPV4_NETMASK__
d-i netcfg/get_gateway string __IPV4_GATEWAY__
d-i netcfg/get_nameservers string __PRIMARY_DNS__
d-i netcfg/confirm_static boolean true
d-i netcfg/get_hostname string __HOSTNAME__
d-i netcfg/get_domain string __DOMAIN__
d-i netcfg/hostname string __HOSTNAME__
d-i hw-detect/load_firmware boolean true

### --- Mirror Configuration --------------------------------------------------
d-i mirror/country string manual
d-i mirror/http/hostname string __DEBIAN_MIRROR_HOST__
d-i mirror/http/directory string __DEBIAN_MIRROR_DIR__
d-i mirror/http/proxy string
d-i mirror/suite string __DEBIAN_RELEASE__

### --- Clock and Timezone ----------------------------------------------------
d-i clock-setup/utc boolean true
d-i time/zone string __TIMEZONE__
d-i clock-setup/ntp boolean true

### --- User Account Setup ----------------------------------------------------
# Disable root login — use sudo instead
d-i passwd/root-login boolean false

# Create the main user account with a LOCKED password (SSH key only)
d-i passwd/user-fullname string __USERNAME__
d-i passwd/username string __USERNAME__
# '!' locks the password — no password login possible, SSH key only
d-i passwd/user-password-crypted string !
d-i user-setup/allow-password-login boolean false
d-i user-setup/encrypt-home boolean false

### --- Partitioning with LUKS Encryption -------------------------------------
# Use the crypto method for encrypted LVM
d-i partman-auto/method string crypto
d-i partman-auto/disk string __DISK__

# LUKS temporary passphrase (swapped with real passphrase in post-install)
d-i partman-crypto/passphrase password __TEMP_LUKS_KEY__
d-i partman-crypto/passphrase-again password __TEMP_LUKS_KEY__
d-i partman-crypto/confirm boolean true
d-i partman-crypto/confirm_nooverwrite boolean true

# Disk erasure mode (fast=false, secure=true)
d-i partman-auto-crypto/erase_disks boolean __ERASE_DISKS__

# LVM configuration
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-auto-lvm/guided_size string max
d-i partman-auto-lvm/new_vg_name string __VG_NAME__

# Remove existing MD arrays
d-i partman-md/device_remove_md boolean true

# UEFI & GPT compatibility
d-i partman-efi/non_efi_system boolean false

# Partitioning recipe (dynamically populated for UEFI or BIOS/Legacy boot mode)
d-i partman-auto/choose_recipe select boot-crypto
d-i partman-auto/expert_recipe string __PARTMAN_RECIPE__

# Auto-confirm partitioning
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

### --- Base System Installation ----------------------------------------------
d-i base-installer/install-recommends boolean true
d-i base-installer/kernel/image string linux-image-amd64

### --- Apt Configuration -----------------------------------------------------
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true
d-i apt-setup/services-select multiselect security, updates
d-i apt-setup/security_host string security.debian.org

### --- Package Selection -----------------------------------------------------
tasksel tasksel/first multiselect ssh-server, standard
d-i pkgsel/include string \
    openssh-server sudo cryptsetup-initramfs dropbear-initramfs \
    fail2ban ufw unattended-upgrades apt-listchanges \
    needrestart auditd libpam-systemd python3-systemd ca-certificates \
    dbus policykit-1 \
    __EXTRA_PACKAGES__
d-i pkgsel/upgrade select full-upgrade
popularity-contest popularity-contest/participate boolean false

### --- Bootloader (GRUB) -----------------------------------------------------
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/bootdev string __DISK__
d-i finish-install/reboot_in_progress note

### --- Late Command (Post-Install Configuration) ----------------------------
# Download and execute the post-install script from the temporary HTTP server.
# This configures SSH hardening, dropbear, network, firewall, etc.
d-i preseed/late_command string \
    in-target wget -O /tmp/postinst.sh http://__PRESEED_SERVER__/postinst.sh; \
    in-target chmod +x /tmp/postinst.sh; \
    in-target /bin/bash /tmp/postinst.sh; \
    in-target rm -f /tmp/postinst.sh
